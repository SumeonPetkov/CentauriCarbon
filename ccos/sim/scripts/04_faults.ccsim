# Safety: every protection layer of the stock firmware, triggered on purpose.
option speed 10
wait_until links == 3 timeout 20

# 1. Broken thermistor wire. min_temp is -200 in printer.cfg, so the MCU's
#    ADC range check does not catch it; verify_heater does (reading < -20 °C)
#    and shuts everything down.
inject hotend_thermistor_open
wait_until shutdown ~ "thermistor fault" timeout 10
wait_until mcu_shutdown ~ "Command request" timeout 2
expect nozzle_pwm == 0
screenshot shots/shutdown.png
clear hotend_thermistor_open
tap "Restart"
wait_until links == 3 timeout 20
wait_until mcu_shutdown == "none" timeout 5
expect shutdown == "none"

# 2. Heater cartridge dead: verify_heater stops everything after
#    check_gain_time (20 s, host time — not sped up).
inject hotend_heater_dead
gcode M104 S200
wait_until shutdown ~ "not heating at expected rate" timeout 40
wait_until mcu_shutdown ~ "Command request" timeout 2
expect nozzle_pwm == 0
expect nozzle < 30
clear hotend_heater_dead
command restart
wait_until links == 3 timeout 20
expect shutdown == "none"

# 3. USB cable pulled while heating: the toolhead MCU switches the heater off
#    by itself when updates stop (max_duration 5 s), and ccos notices the
#    silence.
gcode M104 S180
wait_until nozzle > 60 timeout 30
inject toolhead_unplugged
wait_until mcu_shutdown ~ "Missed scheduling of next digital out event" timeout 8
expect nozzle_pwm == 0
wait_until shutdown ~ "no response" timeout 10
clear toolhead_unplugged
command restart
wait_until links == 3 timeout 20
expect mcu_shutdown == "none"

# 4. A move on an unhomed axis is silently dropped (no error, no motion).
gcode G1 X50 F3000
wait 1
expect x > 117.29
expect x < 117.31
expect lost_steps == 0
expect shutdown == "none"
# and an out-of-range temperature is only warned about, then set
gcode M104 S400
wait 0.5
expect host_nozzle > 0
gcode M104 S0
