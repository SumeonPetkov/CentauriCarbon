# Print a file from the Print screen and check what came out of the nozzle.
option speed 20
wait_until links == 3 timeout 20
goto print
wait 0.3
tap "cube_20mm.gcode"
wait_until print_state == "Printing" timeout 5
wait_until layers >= 2 timeout 120
screenshot shots/printing.png
wait_until print_state == "Finished" timeout 180
# prime line (x 10..60 at y 5) + the 20 mm cube centred at 128,128
expect layers == 6
expect bbox_x0 > 9.9
expect bbox_x0 < 10.1
expect bbox_x1 > 137.9
expect bbox_x1 < 138.3
expect bbox_y1 > 137.9
expect bbox_y1 < 138.3
expect max_z > 0.99
expect max_z < 1.01
expect cold_extrusion == 0
expect lost_steps == 0
expect push_x < 0.05
expect push_z < 0.05
expect mcu_shutdown == "none"
expect shutdown == "none"
# end G-code turned everything off
wait 1
expect nozzle_pwm == 0
expect bed_pwm == 0
expect part_fan == 0
bedshot shots/cube_bed.png
screenshot shots/finished.png
